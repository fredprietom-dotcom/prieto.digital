# Clave de la API de Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Opcional pero recomendado: rate limiting por IP con Upstash Redis
# (https://console.upstash.com — free tier). Sin estas variables, el
# endpoint funciona pero sin límite de solicitudes por IP.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
